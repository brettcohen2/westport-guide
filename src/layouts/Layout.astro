---
import '../styles/global.css';

const { title = "Westport, Unfiltered" } = Astro.props;
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
  </head>
  <body>
    <header style="border-bottom: 0.5px solid var(--color-border);">
      <div class="wrap" style="display:flex; align-items:center; justify-content:space-between; padding: 20px 0;">
        <a href="/" style="font-family: var(--font-display); font-weight:500; font-size:19px; color: var(--color-ink); letter-spacing:-0.02em;">
          Westport, Unfiltered
        </a>
        <nav style="display:flex; gap:24px; font-size:13px; color: var(--color-ink-soft);">
          <a href="/restaurants" style="color:inherit;">Restaurants</a>
          <a href="/about" style="color:inherit;">About</a>
          <a href="/contact" style="color:inherit;">Contact</a>
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer style="border-top: 0.5px solid var(--color-border); margin-top: 40px;">
      <div class="wrap" style="padding: 16px 0; font-size:11.5px; color: var(--color-ink-muted);">
        Westport, Unfiltered — an insider's guide, not a brochure.
      </div>
    </footer>
  </body>
</html>
