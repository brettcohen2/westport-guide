---
import '../styles/global.css';

const { title = "Westport, Unfiltered" } = Astro.props;
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
  </head>
  <body style="display:flex; flex-direction:column; min-height:100vh;">
    <header style="border-bottom: 0.5px solid var(--color-border);">
      <div class="wrap nav-row">
        <a href="/" class="wordmark">
          Westport, Unfiltered
        </a>
        <nav class="nav-links">
          <a href="/restaurants">Restaurants</a>
          <a href="/about">About</a>
          <a href="/contact">Contact</a>
        </nav>
      </div>
    </header>

    <main style="flex:1;">
      <slot />
    </main>

    <footer style="border-top: 0.5px solid var(--color-border); margin-top: 40px;">
      <div class="wrap" style="padding-top: 16px; padding-bottom: 16px; font-size:11.5px; color: var(--color-ink-muted);">
        Westport, Unfiltered — an insider's guide, not a brochure.
      </div>
    </footer>

    <style>
      .nav-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding-top: 20px;
        padding-bottom: 20px;
        flex-wrap: wrap;
        gap: 10px;
      }
      .wordmark {
        font-family: var(--font-display);
        font-weight: 500;
        font-size: 19px;
        color: var(--color-ink);
        letter-spacing: -0.02em;
        text-decoration: none;
      }
      .nav-links {
        display: flex;
        gap: 20px;
        font-size: 13px;
        color: var(--color-ink-soft);
      }
      .nav-links a {
        color: inherit;
        text-decoration: none;
      }
      @media (max-width: 480px) {
        .wordmark { font-size: 16px; }
        .nav-links { gap: 14px; font-size: 12px; }
      }
    </style>
  </body>
</html>
