---
import Layout from "../../layouts/Layout.astro";
import { restaurants } from "../../data/restaurants.js";

export function getStaticPaths() {
  return restaurants.map(r => ({
    params: { slug: r.slug },
    props: { restaurant: r },
  }));
}

const { restaurant } = Astro.props;
const { name, category, price, neighborhood, score, scoreExplainer, review, whatToOrder, tags, address, website, photoColor } = restaurant;
---
<Layout title={"" + name + " — Westport, Unfiltered"}>
  <div class="wrap" style="padding-top: 14px;">
    <p style="font-size:12px; color: var(--color-ink-muted);">
      <a href="/restaurants" style="color: var(--color-ink-muted);">Restaurants</a> / {name}
    </p>
  </div>

  <div class="wrap" style="padding-top:14px;">
    <div style={"background:" + photoColor + "; min-height:200px; border-radius: var(--radius); display:flex; align-items:flex-end; padding:16px;"}>
      <span style="font-size:12px; color:#DCE4E8; opacity:0.85;">photo — {name}</span>
    </div>
  </div>

  <div class="wrap detail-grid" style="padding-top:24px; display:grid; grid-template-columns: 1.4fr 1fr; gap:28px;">
    <div>
      <div class="title-row" style="display:flex; align-items:flex-start; justify-content:space-between; gap:16px; margin-bottom:6px;">
        <h1 class="detail-title" style="font-size:26px;">{name}</h1>
        <div style="text-align:center; flex-shrink:0;">
          <p style="font-family: var(--font-display); font-weight:600; font-size:22px; color: var(--color-sound); margin:0; line-height:1;">{score}</p>
          <p style="font-size:10px; color: var(--color-ink-muted); margin:2px 0 0;">out of 10</p>
          <a href="/about#ratings" style="font-size:10px; color: var(--color-sound); margin-top:3px; display:block;">How we rate</a>
        </div>
      </div>
      <p style="font-size:13px; color: var(--color-ink-soft); margin-bottom:16px;">{category} · {price} · {neighborhood}</p>

      {review.map(paragraph => (
        <p style="font-size:14px; line-height:1.7; color:#3B3E39; margin-bottom:12px;">{paragraph}</p>
      ))}

      <div style="background: var(--color-bg-tint); border-radius: var(--radius); padding:18px 20px; margin-top:6px;">
        <p style="font-family: var(--font-display); font-weight:500; font-size:14px; margin-bottom:8px; color: var(--color-sound);">Why it's a {score}</p>
        <p style="font-size:13px; line-height:1.6; color:#3B3E39;">{scoreExplainer}</p>
      </div>
    </div>

    <div>
      <div style="background: var(--color-bg-tint); border-radius: var(--radius); padding:18px; margin-bottom:14px;">
        <p style="font-size:11px; color: var(--color-ink-muted); margin-bottom:4px;">Address</p>
        <p style="font-size:13px; margin-bottom:14px;">{address}</p>
        <p style="font-size:11px; color: var(--color-ink-muted); margin-bottom:4px;">Website</p>
        <p style="font-size:13px; color: var(--color-sound);">{website}</p>
      </div>

      <p style="font-family: var(--font-display); font-weight:500; font-size:14px; margin-bottom:10px;">What to order</p>
      {whatToOrder.map(dish => (
        <div style="border-left:2px solid var(--color-sound); padding-left:12px; margin-bottom:8px;">
          <p style="font-size:13px; font-weight:500;">{dish}</p>
        </div>
      ))}

      <div style="display:flex; gap:6px; flex-wrap:wrap; margin: 16px 0;">
        {tags.map(tag => (
          <span style="border:0.5px solid var(--color-border-strong); border-radius: var(--radius-sm); padding:5px 10px; font-size:11.5px; color: var(--color-ink-soft);">{tag}</span>
        ))}
      </div>

      <div style="background: var(--color-shingle); border-radius: var(--radius); height:140px; display:flex; align-items:center; justify-content:center;">
        <span style="font-size:12px; color:#5C5450;">map embed — {address}</span>
      </div>
    </div>
  </div>

  <style>
    @media (max-width: 720px) {
      .detail-grid { grid-template-columns: 1fr !important; }
    }
    @media (max-width: 420px) {
      .detail-title { font-size: 22px !important; }
      .title-row { flex-wrap: wrap; }
    }
  </style>
</Layout>
