---
import Layout from "../../layouts/Layout.astro";
import { attractions } from "../../data/attractions.js";
import { withPhoto } from "../../lib/photos.js";

export function getStaticPaths() {
  return attractions.map(p => ({
    params: { slug: p.slug },
    props: { item: withPhoto(p) },
  }));
}

const { item } = Astro.props;
const { name, neighborhood, description, quickFacts, goodToKnow, tags, address, website, websiteUrl, photoColor, photo } = item;
---
<Layout title={"" + name + " — Westport, Unfiltered"}>
  <div class="wrap" style="padding-top: 14px;">
    <p style="font-size:12px; color: var(--color-ink-muted);">
      <a href="/explore" style="color: var(--color-ink-muted);">Explore</a> / {name}
    </p>
  </div>

  <div class="wrap" style="padding-top:14px;">
    {photo ? (
      <img src={photo} alt={name} style="width:100%; height:320px; object-fit:cover; border-radius: var(--radius); display:block;" />
    ) : (
    <div style={"background:" + photoColor + "; min-height:200px; border-radius: var(--radius); display:flex; align-items:flex-end; padding:16px;"}>
      <span style="font-size:12px; color:#DCE4E8; opacity:0.85;">photo — {name}</span>
    </div>
    )}
  </div>

  <div class="wrap detail-grid" style="padding-top:24px; display:grid; grid-template-columns: 1.4fr 1fr; gap:28px;">
    <div>
      <h1 style="font-size:26px; margin-bottom:6px;">{name}</h1>
      <p style="font-size:13px; color: var(--color-ink-soft); margin-bottom:16px;">Attraction · {neighborhood}</p>

      <p style="font-size:14px; line-height:1.7; color:#3B3E39; margin-bottom:16px;">{description}</p>

      {goodToKnow.length > 0 && (
      <div style="background: var(--color-bg-tint); border-radius: var(--radius); padding:16px 18px; margin-bottom:16px;">
        <p style="font-family: var(--font-display); font-weight:500; font-size:13px; margin-bottom:8px; color: var(--color-sound);">Good to know</p>
        <ul style="margin:0; padding-left:18px;">
          {goodToKnow.map(tip => (
            <li style="font-size:13px; line-height:1.6; color:#3B3E39; margin-bottom:4px;">{tip}</li>
          ))}
        </ul>
      </div>
      )}

      <div style="display:flex; gap:6px; flex-wrap:wrap;">
        {tags.map(tag => (
          <span style="border:0.5px solid var(--color-border-strong); border-radius: var(--radius-sm); padding:5px 10px; font-size:11.5px; color: var(--color-ink-soft);">{tag}</span>
        ))}
      </div>
    </div>

    <div>
      <div style="background: var(--color-bg-tint); border-radius: var(--radius); padding:18px;">
        {quickFacts.map(fact => (
          <div style="margin-bottom:12px;">
            <p style="font-size:11px; color: var(--color-ink-muted); margin-bottom:4px;">{fact.label}</p>
            <p style="font-size:13px; margin:0;">{fact.value}</p>
          </div>
        ))}
        <p style="font-size:11px; color: var(--color-ink-muted); margin-bottom:4px;">Address</p>
        <p style="font-size:13px; margin-bottom:12px;">{address}</p>
        {website && (
          <div>
            <p style="font-size:11px; color: var(--color-ink-muted); margin-bottom:4px;">Website</p>
            <p style="font-size:13px; margin:0;"><a href={websiteUrl} target="_blank" rel="noopener noreferrer" style="color: var(--color-sound); word-break: break-all;">{website}</a></p>
          </div>
        )}
      </div>
    </div>
  </div>

  <div class="wrap" style="padding-top:24px; padding-bottom:44px;">
    <p style="font-family: var(--font-display); font-weight:500; font-size:15px; margin-bottom:10px;">Getting there</p>
    <iframe
      title={"Map of " + name}
      src={"https://www.google.com/maps?q=" + encodeURIComponent(name + ", " + address) + "&output=embed"}
      width="100%"
      height="320"
      style="border:0; border-radius: var(--radius); display:block;"
      loading="lazy"
      referrerpolicy="no-referrer-when-downgrade"
      allowfullscreen
    ></iframe>
  </div>

  <style>
    @media (max-width: 720px) {
      .detail-grid { grid-template-columns: 1fr !important; }
    }
  </style>
</Layout>
