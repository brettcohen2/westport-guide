---
import Layout from "../layouts/Layout.astro";
---
<Layout title="Contact — Westport, Unfiltered">
  <section class="wrap" style="padding-top: 40px; padding-bottom: 40px; max-width: 560px;">
    <h1 style="font-size:26px; margin-bottom:16px;">Contact</h1>
    <p style="font-size:14px; line-height:1.7; color: var(--color-ink-soft); margin-bottom:24px;">
      Have a restaurant recommendation, a tip, or just want to say hi? Reach us on Instagram —
      that's where we're most likely to actually see your message.
    </p>

    <a
      href="https://instagram.com"
      target="_blank"
      rel="noopener noreferrer"
      style="display:inline-flex; align-items:center; gap:8px; font-size:14px; font-weight:500; color: var(--color-bg); background: var(--color-sound); padding: 12px 18px; border-radius: var(--radius-sm);"
    >
      Message us on Instagram
    </a>
  </section>
</Layout>
