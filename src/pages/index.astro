---
import Layout from "../layouts/Layout.astro";
import RestaurantCard from "../components/RestaurantCard.jsx";
import { restaurants } from "../data/restaurants.js";

const recent = restaurants.slice(0, 3);
---
<Layout title="Westport, Unfiltered">
  <section class="wrap" style="display:grid; grid-template-columns: 1.1fr 0.9fr; gap:0; align-items:center; padding: 44px 0 36px;">
    <div style="padding-right: 32px;">
      <h1 style="font-size: 30px;">Where to actually eat in Westport.</h1>
      <p style="font-size:14px; line-height:1.6; color: var(--color-ink-soft); margin: 14px 0 18px; max-width: 34ch;">
        Honest reviews from someone who's eaten at all of them. No sponsored placements, no press-release copy.
      </p>
      <a href="/restaurants" style="display:inline-flex; align-items:center; gap:6px; font-size:13px; font-weight:500; color: var(--color-bg); background: var(--color-sound); padding: 10px 16px; border-radius: var(--radius-sm);">
        Browse restaurants
      </a>
    </div>
    <div style="background: var(--color-shingle); min-height: 260px; border-radius: var(--radius); display:flex; align-items:flex-end; padding:16px;">
      <span style="font-size:12px; color:#2C2C2A; opacity:0.7;">photo — hero image</span>
    </div>
  </section>

  <section class="wrap" style="padding: 28px 0;">
    <h2 style="font-size:16px; margin-bottom: 6px;">Recently reviewed</h2>
    <p style="font-size:12.5px; color: var(--color-ink-muted); margin-bottom:16px;">Updated a few times a month</p>
    <div style="display:grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap:16px;">
      {recent.map(r => <RestaurantCard restaurant={r} client:visible />)}
    </div>
  </section>
</Layout>
