---
import Layout from "../layouts/Layout.astro";
import RestaurantCard from "../components/RestaurantCard.jsx";
import ExploreCard from "../components/ExploreCard.jsx";
import { restaurants } from "../data/restaurants.js";
import { parks } from "../data/parks.js";
import { beaches } from "../data/beaches.js";
import { attractions } from "../data/attractions.js";

const recentRestaurants = restaurants.slice(0, 6);
const exploreFeatured = [...parks, ...beaches, ...attractions].slice(0, 6);

const quickLinks = [
  { label: "Date night", tag: "Date night" },
  { label: "Kid-friendly", tag: "Kid-friendly" },
  { label: "Cheap eats", tag: "Cheap eats" },
  { label: "Outdoor seating", tag: "Outdoor seating" },
];
---
<Layout title="Westport, Unfiltered">
  <section class="wrap hero-grid">
    <div class="hero-text">
      <h1 style="font-size: 30px;">The insider's guide to Westport.</h1>
      <p style="font-size:14px; line-height:1.6; color: var(--color-ink-soft); margin: 14px 0 18px; max-width: 34ch;">
        Where to eat, where to go, and what's actually worth your time — from two people who live here. No sponsored placements, no press-release copy.
      </p>
      <div style="display:flex; gap:10px; flex-wrap:wrap;">
        <a href="/restaurants" style="display:inline-flex; align-items:center; gap:6px; font-size:13px; font-weight:500; color: var(--color-bg); background: var(--color-sound); padding: 10px 16px; border-radius: var(--radius-sm);">
          Browse restaurants
        </a>
        <a href="/explore" style="display:inline-flex; align-items:center; gap:6px; font-size:13px; font-weight:500; color: var(--color-sound); border: 0.5px solid var(--color-border-strong); padding: 10px 16px; border-radius: var(--radius-sm);">
          Explore Westport
        </a>
      </div>
    </div>
    <div class="hero-photo">
      <span style="font-size:12px; color:#2C2C2A; opacity:0.7;">photo — hero image</span>
    </div>
  </section>

  <section class="wrap" style="padding-top: 8px; padding-bottom: 32px; border-top: 0.5px solid var(--color-border); border-bottom: 0.5px solid var(--color-border);">
    <div style="display:flex; gap:10px; overflow-x:auto; padding: 18px 0;">
      {quickLinks.map(link => (
        <a
          href={"/restaurants?tag=" + encodeURIComponent(link.tag)}
          style="border:0.5px solid var(--color-border-strong); border-radius: var(--radius-sm); padding:8px 14px; font-size:12.5px; color: var(--color-ink-soft); white-space:nowrap; flex-shrink:0;"
        >
          {link.label}
        </a>
      ))}
    </div>
  </section>

  <section class="wrap" style="padding-top: 28px; padding-bottom: 28px;">
    <div style="display:flex; align-items:baseline; justify-content:space-between; margin-bottom: 6px;">
      <h2 style="font-size:16px;">Explore Westport</h2>
      <a href="/explore" style="font-size:12.5px; color: var(--color-sound);">View all</a>
    </div>
    <p style="font-size:12.5px; color: var(--color-ink-muted); margin-bottom:16px;">Parks, beaches, and a bit of culture</p>
    <div class="shelf" style="display:flex; gap:16px; overflow-x:auto; padding-bottom: 8px;">
      {exploreFeatured.map(item => (
        <div style="min-width: 220px; max-width: 220px; flex-shrink:0;">
          <ExploreCard item={item} client:visible />
        </div>
      ))}
    </div>
  </section>

  <section class="wrap" style="padding-top: 8px; padding-bottom: 28px;">
    <div style="display:flex; align-items:baseline; justify-content:space-between; margin-bottom: 6px;">
      <h2 style="font-size:16px;">Recently reviewed restaurants</h2>
      <a href="/restaurants" style="font-size:12.5px; color: var(--color-sound);">View all</a>
    </div>
    <p style="font-size:12.5px; color: var(--color-ink-muted); margin-bottom:16px;">Updated a few times a month</p>
    <div class="shelf" style="display:flex; gap:16px; overflow-x:auto; padding-bottom: 8px;">
      {recentRestaurants.map(r => (
        <div style="min-width: 220px; max-width: 220px; flex-shrink:0;">
          <RestaurantCard restaurant={r} client:visible />
        </div>
      ))}
    </div>
  </section>

  <section class="wrap about-teaser-grid">
    <div class="about-teaser-photo"></div>
    <div>
      <h2 style="font-size:18px; margin-bottom:10px;">Who's behind this</h2>
      <p style="font-size:13.5px; line-height:1.7; color: var(--color-ink-soft); margin-bottom:14px; max-width: 42ch;">
        We're the two people eating our way through Westport, and exploring the rest of it too, so you don't have to guess.
        No sponsored visits, no press-release copy — just our honest take.
      </p>
      <a href="/about" style="font-size:13px; font-weight:500; color: var(--color-sound);">Meet us →</a>
    </div>
  </section>

  <style>
    .hero-grid {
      display: grid;
      grid-template-columns: 1.1fr 0.9fr;
      gap: 28px;
      align-items: center;
      padding-top: 44px;
      padding-bottom: 36px;
    }
    .hero-photo {
      background: var(--color-shingle);
      min-height: 260px;
      border-radius: var(--radius);
      display: flex;
      align-items: flex-end;
      padding: 16px;
    }
    .about-teaser-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 28px;
      align-items: center;
      padding-top: 12px;
      padding-bottom: 44px;
    }
    .about-teaser-photo {
      background: var(--color-shingle);
      min-height: 180px;
      border-radius: var(--radius);
    }

    @media (max-width: 720px) {
      .hero-grid {
        grid-template-columns: 1fr;
        padding-top: 28px;
        padding-bottom: 24px;
      }
      .hero-photo {
        min-height: 180px;
        order: -1;
      }
      .about-teaser-grid {
        grid-template-columns: 1fr;
      }
      .about-teaser-photo {
        min-height: 140px;
      }
    }
  </style>
</Layout>
